---
import { nav, socials, links } from '../data/site.js';
---

<header class="site-header" data-site-header data-scrolled="false">
  <!-- Main bar -->
  <nav class="mainbar" aria-label="Main">
    <div class="container-hoe d-flex align-items-center">
      <a href="/" class="site-logo me-auto me-xl-4" aria-label="AAJneeti Connect Ltd. home">
        <img src="/images/logo-white.png" alt="AAJneeti Connect Ltd." class="logo-light" width="190" height="56" />
        <img src="/images/logo.webp" alt="" class="logo-dark" width="190" height="56" aria-hidden="true" />
      </a>

      <ul class="nav-desktop d-none d-xl-flex list-unstyled m-0 me-auto">
        {nav.map((item) =>
          item.items ? (
            <li class="nav-dd">
              <button class="nav-link-hoe" type="button" aria-haspopup="true">
                {item.label} <i class="bi bi-chevron-down"></i>
              </button>
              <div class="dd-panel">
                <div class="dd-inner">
                  <div class="dd-list">
                    <p class="dd-heading">{item.label}</p>
                    <ul class="list-unstyled m-0">
                      {item.items.map((l) => (
                        <li>
                          <a href={l.href} class="dd-item">
                            <span class="dd-title">{l.title}</span>
                            {l.sub && <span class="dd-sub">{l.sub}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <a href={item.items[0].href} class="dd-feature">
                    <span class="eyebrow mb-2">AAJneeti</span>
                    <span class="dd-feature-title">{item.feature}</span>
                    <span class="link-more mt-auto">Explore <i class="bi bi-arrow-right"></i></span>
                  </a>
                </div>
              </div>
            </li>
          ) : (
            <li><a href={item.href} class="nav-link-hoe">{item.label}</a></li>
          )
        )}
      </ul>

      <div class="d-none d-xl-flex align-items-center gap-3">
        <a href={links.payment} class="nav-link-hoe"><i class="bi bi-credit-card-2-front me-1"></i>Pay Now</a>
        <a href={links.products} class="nav-link-hoe hide-xl-only">Client Area</a>
        <a href={links.contact} class="btn-pill btn-grad sm">Get Started</a>
      </div>

      <div class="d-flex d-xl-none align-items-center gap-2">
        <a href={links.contact} class="btn-pill btn-grad sm d-none d-sm-inline-flex">Get Started</a>
        <button class="burger" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open the menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </nav>
</header>

<!-- Mobile navigation -->
<div class="offcanvas offcanvas-end mobile-nav" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
  <div class="offcanvas-header">
    <img src="/images/logo.webp" alt="AAJneeti Connect Ltd." height="44" />
    <h2 class="visually-hidden" id="mobileNavLabel">Navigation</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close the menu"></button>
  </div>
  <div class="offcanvas-body d-flex flex-column">
    <ul class="list-unstyled m-0">
      {nav.map((item, i) =>
        item.items ? (
          <li class="mob-item">
            <button class="mob-link collapsed" type="button" data-bs-toggle="collapse" data-bs-target={`#mob-${i}`} aria-expanded="false">
              {item.label} <i class="bi bi-plus-lg"></i>
            </button>
            <div class="collapse" id={`mob-${i}`}>
              <ul class="list-unstyled mob-sub">
                {item.items.map((l) => <li><a href={l.href}>{l.title}</a></li>)}
              </ul>
            </div>
          </li>
        ) : (
          <li class="mob-item"><a href={item.href} class="mob-link">{item.label}</a></li>
        )
      )}
      <li class="mob-item"><a href={links.payment} class="mob-link">Pay Now</a></li>
      <li class="mob-item"><a href={links.products} class="mob-link">Client Area</a></li>
    </ul>
    <a href={links.contact} class="btn-pill btn-grad lg mt-4 w-100">Get Started <i class="bi bi-arrow-right"></i></a>
    <div class="d-flex gap-2 mt-auto pt-4">
      {socials.map((s) => (
        <a href={s.href} class="mob-social" target="_blank" rel="noopener" aria-label={s.name}><i class={`bi ${s.icon}`}></i></a>
      ))}
    </div>
  </div>
</div>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 1030;
    color: var(--slate-50);
    transition: background-color .35s var(--ease), box-shadow .35s var(--ease), color .35s var(--ease);
  }
  .site-header[data-scrolled='true'] {
    background: #fff; color: var(--navy);
    box-shadow: 0 1px 0 var(--slate-100), 0 10px 30px -15px rgb(15 23 42 / .2);
  }

  /* Main bar */
  .mainbar { height: var(--header-h); display: flex; align-items: center; }
  .mainbar > .container-hoe { width: 100%; }
  .site-logo { position: relative; display: block; height: 46px; width: 156px; flex-shrink: 0; }
  .site-logo img { position: absolute; inset: 0; height: 100%; width: auto; object-fit: contain; transition: opacity .3s var(--ease); }
  .logo-dark { opacity: 0; }
  [data-scrolled='true'] .logo-light { opacity: 0; }
  [data-scrolled='true'] .logo-dark { opacity: 1; }

  .nav-desktop { gap: 0; }
  @media (max-width: 1399.98px) { .hide-xl-only { display: none !important; } }
  .nav-link-hoe {
    background: none; border: 0; color: inherit;
    font-family: var(--font-body); font-weight: 500; font-size: .9rem;
    padding: .55rem .7rem; border-radius: 999px; white-space: nowrap;
    display: inline-flex; align-items: center; gap: .35rem;
  }
  .nav-link-hoe .bi-chevron-down { font-size: .65rem; transition: transform .3s var(--ease); }
  .nav-link-hoe:hover, .nav-dd:hover > .nav-link-hoe { color: var(--red); }
  .nav-dd { position: relative; }
  .nav-dd:hover .bi-chevron-down, .nav-dd:focus-within .bi-chevron-down { transform: rotate(180deg); }

  /* Dropdown panel — HOE: white, rounded-lg, shadow-xl */
  .dd-panel {
    position: absolute; top: 100%; left: 50%;
    padding-top: .9rem;
    opacity: 0; visibility: hidden;
    transform: translate(-50%, 8px);
    transition: all .3s var(--ease);
  }
  .nav-dd:hover .dd-panel, .nav-dd:focus-within .dd-panel { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  .dd-inner {
    display: grid; grid-template-columns: 1fr 13rem; gap: 1rem;
    width: 34rem; padding: 1.25rem;
    background: #fff; color: var(--navy);
    border-radius: var(--radius); box-shadow: 0 25px 50px -12px rgb(15 23 42 / .35);
    border: 1px solid var(--slate-100);
  }
  .dd-heading { font-family: var(--font-accent); font-size: .65rem; letter-spacing: .18em; text-transform: uppercase; color: var(--slate-400); margin: .25rem .75rem .75rem; }
  .dd-item { display: block; padding: .6rem .75rem; border-radius: .5rem; }
  .dd-item:hover { background: var(--slate-50); }
  .dd-title { display: block; font-size: .875rem; font-weight: 500; line-height: 1.25; color: var(--navy); transition: color .2s; }
  .dd-item:hover .dd-title { color: var(--red); }
  .dd-sub { display: block; font-size: .75rem; color: var(--slate-500); margin-top: .15rem; }
  .dd-feature {
    display: flex; flex-direction: column; padding: 1.25rem;
    border-radius: .5rem; color: var(--navy);
    background: var(--grad-soft);
  }
  .dd-feature-title { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; line-height: 1.25; letter-spacing: -0.02em; margin-bottom: 1.5rem; }

  /* Burger */
  .burger { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid currentColor; background: transparent; color: inherit; display: grid; place-content: center; gap: 4px; }
  .burger span { display: block; width: 18px; height: 1.5px; background: currentColor; }

  /* Mobile offcanvas */
  .mobile-nav { --bs-offcanvas-width: min(400px, 90vw); }
  .mob-item { border-bottom: 1px solid var(--slate-100); }
  .mob-link { width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: 0; padding: 1rem 0; font-family: var(--font-display); font-weight: 500; font-size: 1.05rem; color: var(--navy); }
  .mob-link .bi { transition: transform .3s; }
  .mob-link:not(.collapsed) .bi { transform: rotate(45deg); color: var(--red); }
  .mob-sub { padding: 0 0 1rem .75rem; margin: 0; }
  .mob-sub a { display: block; padding: .4rem 0; font-size: .9rem; color: var(--navy-600); }
  .mob-sub a:hover { color: var(--red); }
  .mob-social { width: 2.5rem; height: 2.5rem; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--slate-200); color: var(--navy); }
  .mob-social:hover { background: var(--red); color: #fff; border-color: var(--red); }
</style>
