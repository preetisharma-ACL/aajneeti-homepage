---
import { links } from '../data/site.js';

// Lead feed — same "real-shaped" leads aajneeti.social cycles through in its hero card
const leadFeed = [
  { n: 'Rohit S.', d: '3 BHK · ₹1.2 to 1.5 Cr · Noida Extension' },
  { n: 'Priya M.', d: 'MBA admission · Lucknow · 2026 intake' },
  { n: 'Neha G.', d: 'Modular kitchen · Gurugram · ₹6 to 8 L' },
  { n: 'Farhan A.', d: 'Kerala holiday · 2 travellers · December' },
];

const proofs = [
  { icon: 'bi-patch-check-fill', text: 'Up to 60% qualified leads' },
  { icon: 'bi-kanban', text: 'Free CRM' },
  { icon: 'bi-graph-up-arrow', text: 'Live dashboard' },
];
---

<!--
  Layout: centred hero (badge → headline → subtext → buttons → "trusted by" + logos).
  Colours: House of Education hero — deep navy edges (#091023) with a softly lit slate backdrop (#424b5a),
  sampled from houseofeducation.com's hero image. Pink/red appears only in the CTA, exactly as on HOE.
-->
<section class="hero" aria-labelledby="hero-title">

  <div class="hero-light" aria-hidden="true"></div>

  <div class="container-hoe hero-inner text-center">
    <p class="hero-kicker" data-aos="fade-up">
      Real estate lead generation agency · Noida, since 2014
    </p>

    <h1 id="hero-title" class="hero-title" data-aos="fade-up" data-aos-delay="80">
      We only take projects<br class="d-none d-md-inline" /> we can <span class="highlight">deliver.</span>
    </h1>

    <p class="hero-sub" data-aos="fade-up" data-aos-delay="160">
      Before you pay, we tell you honestly if your project can get qualified leads. Up to 60% are qualified, written into
      your contract, and we refund every qualified lead we miss.
    </p>

    <div class="d-flex flex-wrap justify-content-center gap-3 mt-4" data-aos="fade-up" data-aos-delay="240">
      <a href={links.contact} class="btn-pill btn-grad lg">Book a free project review <i class="bi bi-arrow-right"></i></a>
      <a href={links.caseStudies} class="btn-pill btn-glass lg">See case studies <i class="bi bi-play-fill"></i></a>
    </div>

    <!-- Live lead card: one lit card on the dark field, cycling through new leads -->
    <div class="lead-wrap" data-aos="fade-up" data-aos-delay="340">
      <div class="lead-card" data-lead-card data-feed={JSON.stringify(leadFeed)} aria-hidden="true">
        <span class="lead-app">AAJ</span>
        <span class="lead-body">
          <b data-lead-title>New lead in your CRM</b>
          <span data-lead-text>{leadFeed[0].n} · {leadFeed[0].d}</span>
        </span>
        <span class="lead-time">now</span>
      </div>
    </div>

    <ul class="hero-proofs list-unstyled" data-aos="fade-up" data-aos-delay="400">
      {proofs.map((p) => <li><i class={`bi ${p.icon}`}></i>{p.text}</li>)}
      <li><span class="stars" role="img" aria-label="4.5 out of 5 stars"><span aria-hidden="true">★★★★</span><span class="star-half" aria-hidden="true">★</span></span>Rated 4.5+ on Google</li>
    </ul>
  </div>

</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding-top: clamp(8rem, 11vw, 9.5rem);
    /* Full-screen hero (same height as before); smaller content is centred inside it */
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    background: #091023; /* HOE hero edge colour */
    color: var(--slate-50);
  }

  /* HOE hero backdrop, reproduced from houseofeducation.com's hero image.
     Measured against an 11×11 colour grid of their image (person excluded): mean ΔRGB 6.5.
     Dark navy top and left third, light building toward lower centre-right, soft lift bottom-right. */
  .hero-light {
    position: absolute; inset: 0; z-index: -2; pointer-events: none;
    background:
      radial-gradient(ellipse 30% 45% at 92% 100%, rgb(60 69 82 / .9) 0%, rgb(60 69 82 / 0) 100%),
      radial-gradient(ellipse 70% 95% at 62% 72%,
        #444d5b 0%,
        #3d4657 18%,
        #313a4b 33%,
        #222a3c 50%,
        #151c2f 68%,
        #0c1326 84%,
        #091023 100%);
  }
  .hero::after { content: none; } /* no fade: hero ends on the HOE gradient, light section follows */

  .hero-inner {
    position: relative; max-width: 62rem; width: 100%;
    flex: 1 0 auto;
    display: flex; flex-direction: column; justify-content: center; align-items: center;
  }

  .hero-kicker {
    display: inline-flex; align-items: center; gap: .6rem;
    font-size: .85rem; font-weight: 500; color: var(--slate-200);
    padding: .45rem 1.1rem; border-radius: 999px;
    background: rgb(255 255 255 / .08); border: 1px solid rgb(255 255 255 / .12);
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.4vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: #fff;
    margin: 0 auto;
  }
  .hero-sub {
    max-width: 46rem; margin: 1.25rem auto 0;
    font-weight: 300; font-size: clamp(1rem, 1.3vw, 1.15rem); line-height: 1.6;
    color: var(--slate-300);
  }

  /* Glass secondary button (the reference's "Watch demo") */
  .btn-glass {
    color: #fff;
    background: rgb(255 255 255 / .1);
    border-color: rgb(255 255 255 / .28);
  }
  .btn-glass:hover { color: var(--navy); background: #fff; border-color: #fff; }


  .hero-proofs {
    display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 1.75rem;
    margin: 1.25rem 0 0; font-size: .88rem; font-weight: 500; color: rgb(255 255 255 / .9);
  }
  .hero-proofs li { display: inline-flex; align-items: center; gap: .45rem; }
  .hero-proofs i { color: var(--brand-bright); }
  .stars { color: #fbbf24; letter-spacing: 1px; --star-on: #fbbf24; --star-off: rgb(255 255 255 / .25); }

  /* Live lead card */
  .lead-wrap { margin-top: 1.75rem; width: 100%; display: flex; justify-content: center; }
  .lead-card {
    display: flex; align-items: center; gap: 12px; width: min(100%, 26rem);
    padding: 10px 14px; border-radius: var(--radius); text-align: left;
    font-family: var(--font-body);
    background: rgb(255 255 255 / .06); border: 1px solid rgb(255 255 255 / .12); color: #fff;
  }
  .lead-card.is-in { animation: leadIn .6s cubic-bezier(.16, 1, .3, 1); }
  @keyframes leadIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  .lead-app { flex: none; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; background: var(--brand); font-family: var(--font-display); font-size: 10px; font-weight: 600; color: #fff; }
  .lead-body { display: flex; flex: 1; flex-direction: column; min-width: 0; line-height: 1.35; }
  .lead-body b { font-family: var(--font-display); font-size: .85rem; font-weight: 500; white-space: nowrap; }
  .lead-body span { overflow: hidden; font-size: .82rem; color: var(--slate-300); text-overflow: ellipsis; white-space: nowrap; }
  .lead-time { flex: none; align-self: flex-start; font-size: .72rem; color: var(--slate-400); }


  @media (max-width: 767.98px) {
    .hero-proofs { gap: .5rem 1.1rem; font-size: .8rem; }
    .btn-pill.lg { width: 100%; }
  }
</style>

<script>
  // Cycle the lead card every 3.2s (as on aajneeti.social); pause when off-screen or tab hidden.
  const card = document.querySelector<HTMLElement>('[data-lead-card]');
  const feed: { n: string; d: string }[] = card ? JSON.parse(card.dataset.feed ?? '[]') : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (card && feed.length > 1 && !reduce) {
    const title = card.querySelector<HTMLElement>('[data-lead-title]');
    const text = card.querySelector<HTMLElement>('[data-lead-text]');
    let i = 0;
    let timer = 0;
    let visible = true;
    const next = () => {
      i = (i + 1) % feed.length;
      if (title) title.textContent = 'New qualified lead';
      if (text) text.textContent = `${feed[i].n} · ${feed[i].d}`;
      card.classList.remove('is-in');
      void card.offsetWidth; // restart the entry animation
      card.classList.add('is-in');
    };
    const start = () => { if (!timer && visible && !document.hidden) timer = window.setInterval(next, 3200); };
    const stop = () => { window.clearInterval(timer); timer = 0; };
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; if (visible) start(); else stop(); }).observe(card);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }
</script>
