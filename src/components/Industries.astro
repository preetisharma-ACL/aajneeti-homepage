---
import ListingCard from './ui/ListingCard.astro';
import { industries, moreIndustries } from '../data/site.js';
---

<section class="section section-soft" id="verticals" aria-labelledby="ind-title">
  <div class="container-hoe">
    <div class="row g-4 align-items-end mb-5">
      <div class="col-lg-6">
        <p class="eyebrow" data-aos="fade-up">Industries</p>
        <h2 id="ind-title" class="title-lg mb-0" data-aos="fade-up" data-aos-delay="80">
          We know what a bad lead looks like <span class="highlight">in your industry.</span>
        </h2>
      </div>
      <div class="col-lg-5 offset-lg-1">
        <p class="text-slate-600 mb-0 lh-lg" data-aos="fade-up" data-aos-delay="160">
          Real estate is where we started in 2014, and it's still most of what we do. A homebuyer, a parent choosing a
          college and a company buying software decide in different ways, and fake leads look different in each. So every
          industry gets its own campaigns, form questions and checks.
        </p>
      </div>
    </div>

    <div class="row g-4">
      {industries.map((ind, i) => (
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay={String((i % 3) * 100)}>
          <ListingCard
            href={ind.href}
            img={ind.img}
            alt={`${ind.name} lead generation`}
            pillRight={`0${i + 1}`}
            label={ind.sub}
            title={ind.name}
            footText="See how we do it"
          >
            <p class="ind-filter"><i class="bi bi-funnel"></i><span>{ind.filter}</span></p>
            {ind.proof && <p class="ind-proof"><i class="bi bi-trophy-fill"></i><span>{ind.proof}</span></p>}
          </ListingCard>
        </div>
      ))}
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2 mt-5" data-aos="fade-up">
      <span class="tag me-2">More industries we serve</span>
      {moreIndustries.map((m) => <a href={m.href} class="chip">{m.label}</a>)}
    </div>
  </div>
</section>

<style>
  .ind-filter { display: flex; gap: .55rem; font-size: .95rem; line-height: 1.6; color: var(--slate-500); margin: 0 0 1rem; }
  .ind-filter i { margin-top: .15rem; }
  .ind-proof { display: flex; gap: .55rem; font-size: .88rem; line-height: 1.5; color: var(--navy); background: var(--red-50); border-radius: calc(var(--radius) - .1rem); padding: .8rem .95rem; margin: 0; }
  .ind-proof i { color: var(--red-600); }
</style>
