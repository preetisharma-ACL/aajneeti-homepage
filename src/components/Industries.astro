---
// Industries — rebuilt to match aajneeti.social: an expanding image-panel gallery.
// Hover / focus / click a panel to open it; closed panels show a vertical label.
import { industries, moreIndustries } from '../data/site.js';
---

<section class="section section-soft" id="verticals" aria-labelledby="ind-title">
  <div class="container-hoe">
    <header class="ind-head text-center" data-aos="fade-up">
      <p class="eyebrow centered">Industries</p>
      <h2 id="ind-title" class="title-lg">We know what a bad lead looks like <span class="text-red">in your industry.</span></h2>
      <p class="ind-aside">
        Real estate is where we started in 2014, and it's still most of what we do. A homebuyer, a parent choosing a college
        and a company buying software decide in different ways, and fake leads look different in each. So every industry gets
        its own campaigns, form questions and checks.
      </p>
    </header>

    <ul class="gallery list-unstyled" data-gallery data-aos="fade-up" data-aos-delay="100">
      {industries.map((ind, i) => (
        <li class={`panel${i === 0 ? ' is-open' : ''}`} tabindex="0">
          <img src={ind.img} alt="" width="900" height="600" loading="lazy" />
          <span class="panel-shade" aria-hidden="true"></span>
          <span class="panel-label" aria-hidden="true">{ind.name}</span>
          <div class="panel-body">
            <span class="panel-num">0{i + 1}</span>
            <h3 class="panel-name">{ind.name}</h3>
            <p class="panel-sub">{ind.sub}</p>
            <p class="panel-filter">{ind.filter}</p>
            {ind.proof && <p class="panel-proof">{ind.proof}</p>}
            <a class="panel-btn" href={ind.href}>See how we do it <i class="bi bi-arrow-right"></i></a>
          </div>
        </li>
      ))}
    </ul>

    <nav class="ind-chips" aria-label="More industries we serve" data-aos="fade-up">
      <span class="ind-chips-label">More industries we serve</span>
      {moreIndustries.map((m) => <a href={m.href}>{m.label} <i class="bi bi-arrow-right"></i></a>)}
    </nav>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const panels = [...g.querySelectorAll<HTMLElement>('.panel')];
    const open = (p: HTMLElement) => panels.forEach((x) => x.classList.toggle('is-open', x === p));
    panels.forEach((p) => {
      p.addEventListener('pointerenter', () => open(p));
      p.addEventListener('focusin', () => open(p));
      p.addEventListener('click', () => open(p));
    });
  });
</script>

<style>
  .ind-head { max-width: 920px; margin: 0 auto clamp(2.5rem, 5vw, 3.5rem); }
  .ind-aside { max-width: 780px; margin: 14px auto 0; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.6; color: var(--navy-600); }

  /* Gallery */
  .gallery { display: flex; gap: 12px; height: 560px; margin: 0; padding: 0; }
  .panel {
    position: relative; flex: 1; min-width: 0; overflow: hidden;
    border-radius: var(--radius-lg); background: var(--navy);
    cursor: pointer; transition: flex 1s cubic-bezier(.16, 1, .3, 1);
  }
  .panel.is-open { flex: 5; cursor: default; }
  .panel:focus-visible { outline: 3px solid rgb(153 0 16 / .55); outline-offset: 3px; }
  .panel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transform: scale(1.08); opacity: .7;
    transition: transform 1.6s cubic-bezier(.16, 1, .3, 1), opacity .8s;
  }
  .panel.is-open img { transform: scale(1); opacity: 1; }
  .panel-shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgb(10 15 20 / .04) 12%, rgb(10 15 20 / .08) 34%, rgb(10 15 20 / .74) 66%, rgb(10 15 20 / .94)); }

  .panel-label {
    position: absolute; left: 50%; bottom: 22px;
    transform: translateX(-50%) rotate(180deg); writing-mode: vertical-rl;
    padding: 12px 9px; border-radius: 999px; background: rgb(15 20 25 / .34);
    font-family: var(--font-display); font-size: 14px; font-weight: 600; letter-spacing: .01em; color: #fff; white-space: nowrap;
    text-shadow: 0 1px 5px rgb(0 0 0 / .5);
    transition: opacity .4s;
  }
  .panel.is-open .panel-label { opacity: 0; }

  .panel-body {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; flex-direction: column; align-items: flex-start;
    padding: clamp(24px, 3.4vw, 42px);
    opacity: 0; transform: translateY(16px); pointer-events: none;
    text-shadow: 0 1px 12px rgb(0 0 0 / .45);
    transition: opacity .6s cubic-bezier(.16, 1, .3, 1), transform .8s cubic-bezier(.16, 1, .3, 1);
  }
  .panel.is-open .panel-body { opacity: 1; transform: none; transition-delay: .3s; pointer-events: auto; }

  .panel-num {
    display: inline-flex; align-items: center; min-height: 26px; padding: 4px 10px;
    border: 1px solid rgb(255 255 255 / .32); border-radius: 999px; background: rgb(18 25 31 / .36);
    font-size: 12px; font-weight: 600; letter-spacing: .08em; color: rgb(255 255 255 / .9);
  }
  .panel-name { margin: 9px 0 0; font-size: clamp(27px, 3vw, 38px); font-weight: 600; line-height: 1.08; letter-spacing: -.035em; color: #fff; }
  .panel-sub { margin: 8px 0 0; font-size: 17px; font-weight: 600; line-height: 1.4; color: rgb(255 255 255 / .96); }
  .panel-filter {
    box-sizing: border-box; width: min(100%, 500px); margin: 14px 0 0; padding: 12px 15px;
    border-radius: 10px; background: rgb(12 18 22 / .42);
    font-size: 14px; line-height: 1.5; color: rgb(255 255 255 / .88);
  }
  .panel-filter::before { display: block; margin-bottom: 3px; content: 'Lead qualification'; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: rgb(255 255 255 / .62); }
  .panel-proof { display: inline-flex; align-items: flex-start; gap: 8px; max-width: 500px; margin: 10px 0 0; font-size: 13px; font-weight: 600; line-height: 1.45; color: #fff; }
  .panel-proof::before {
    content: '✓'; flex: none; display: grid; place-items: center; width: 19px; height: 19px; margin-top: 1px;
    border-radius: 50%; background: rgb(126 226 168 / .18); color: #7ee2a8; font-size: 12px;
  }
  .panel-btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; margin-top: 18px; padding: 11px 18px;
    border-radius: 999px; background: #fff; color: var(--brand-blue);
    font-size: 14px; font-weight: 600; text-shadow: none;
    transition: background .25s, color .25s;
  }
  .panel-btn:hover { background: var(--brand); color: #fff; }

  /* More industries chips (with arrows, like the live site) */
  .ind-chips { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; margin-top: 36px; }
  .ind-chips-label { margin-right: 6px; font-size: 15px; color: var(--slate-500); }
  .ind-chips a {
    display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 999px;
    background: #fff; border: 1px solid var(--slate-200);
    font-size: 15px; font-weight: 500; color: var(--navy); transition: border-color .3s, color .3s;
  }
  .ind-chips a i { color: var(--brand); }
  .ind-chips a:hover { border-color: var(--navy); }

  /* Tablet & mobile: swipeable row, every panel open */
  @media (max-width: 899px) {
    .gallery { height: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; scrollbar-width: none; }
    .gallery::-webkit-scrollbar { display: none; }
    .panel, .panel.is-open { flex: 0 0 84%; height: 460px; scroll-snap-align: start; }
    .panel img { transform: none; opacity: 1; }
    .panel-shade { background: linear-gradient(180deg, rgb(10 15 20 / .06) 10%, rgb(10 15 20 / .34) 38%, rgb(10 15 20 / .88) 68%, rgb(10 15 20 / .96)); }
    .panel-label { display: none; }
    .panel-body { opacity: 1; transform: none; padding: 24px; pointer-events: auto; }
    .panel-name { font-size: 30px; }
    .panel-sub { margin-top: 6px; font-size: 16px; }
    .panel-filter { margin-top: 11px; padding: 10px 12px; font-size: 13.5px; }
    .panel-proof { font-size: 12.5px; }
  }
  @media (max-width: 640px) {
    .ind-chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 28px; }
    .ind-chips-label { grid-column: 1 / -1; margin: 0 0 4px; font-size: 14px; font-weight: 600; text-align: center; color: var(--navy); }
    .ind-chips a { justify-content: center; min-height: 48px; padding: 8px 10px; border-radius: 14px; background: #fff; border-color: transparent; font-size: 13.5px; text-align: center; }
    .ind-chips a:last-of-type:nth-of-type(odd) { grid-column: 1 / -1; }
  }
</style>
