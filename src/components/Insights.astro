---
import { posts, links } from '../data/site.js';
---

<section class="section bg-white" aria-labelledby="blog-title">
  <div class="container-hoe">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-4 mb-5">
      <div style="max-width: 44rem;">
        <p class="eyebrow" data-aos="fade-up">Insights</p>
        <h2 id="blog-title" class="title-lg" data-aos="fade-up" data-aos-delay="80">Lessons from the campaigns <span class="text-red">we run.</span></h2>
        <p class="text-slate-600 mb-0 lh-lg" data-aos="fade-up" data-aos-delay="140">
          Practical notes for developers, channel partners and brokers: what's working in real estate marketing, what kind of
          leads each channel brings, and which market risks to watch. Written by the team that runs the campaigns.
        </p>
      </div>
      <a href={links.blog} class="btn-pill btn-ghost-dark" data-aos="fade-up">Read the blog <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-4">
      {posts.map((p, i) => (
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay={String(i * 120)}>
          <a href={links.blog} class="post d-flex flex-column text-reset h-100">
            <div class="post-media img-zoom">
              <img src={p.img} alt={p.title} loading="lazy" />
            </div>
            <div class="d-flex align-items-center gap-3 mt-4 mb-2">
              <span class="post-tag">{p.tag}</span>
              <span class="small text-slate-500"><i class="bi bi-clock me-1"></i>{p.read}</span>
            </div>
            <h3 class="post-title">{p.title}</h3>
            <span class="link-more mt-auto align-self-start">Read <i class="bi bi-arrow-right"></i></span>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .post-media { border-radius: var(--radius); aspect-ratio: 16 / 10; box-shadow: 0 20px 40px -25px rgb(15 23 42 / .4); }
  .post-media img { width: 100%; height: 100%; object-fit: cover; }
  .post-tag { font-size: .7rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--red-600); background: var(--red-50); border: 1px solid var(--red-200); border-radius: 999px; padding: .2rem .7rem; }
  .post-title { font-size: 1.2rem; line-height: 1.35; margin-bottom: 1.25rem; transition: color .25s; }
  .post:hover .post-title, .post:hover .link-more { color: var(--red); }
</style>
