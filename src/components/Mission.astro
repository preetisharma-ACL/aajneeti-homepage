---
---

<!-- "Why your money is safe" — light theme -->
<section class="section money-safe-light" aria-labelledby="mission-title">
  <div class="container-hoe">
    <!-- Layout: label on top; heading left half, text right half; spend strip full width below -->
    <p class="eyebrow ms-eyebrow" data-aos="fade-up">Why your money is safe with us</p>

    <div class="row g-5">
      <div class="col-lg-6">
        <h2 id="mission-title" class="title-lg ms-title mb-0" data-aos="fade-up" data-aos-delay="80">
          We treat your ad budget like money we have to <span class="text-red">answer for.</span>
        </h2>
      </div>
      <div class="col-lg-6">
        <p class="ms-lede" data-aos="fade-up" data-aos-delay="160">
          Many agencies earn more when you spend more. Our team is measured on <strong>cost per qualified lead</strong>,
          not on how much we spend, so it's built to spend less and generate more. Smaller budgets pay per lead and larger
          budgets work on a retainer, with the same rule either way.
        </p>
      </div>
    </div>

    <p class="ms-strip" data-aos="fade-up" data-aos-delay="200">
      <span class="ms-num">₹300 crore+</span>
      <span class="ms-txt">of ad spend managed since 2014</span>
    </p>
  </div>
</section>

<style>
  .money-safe-light { background: #fff; color: var(--navy); }
  .ms-title { color: var(--navy); }
  .ms-eyebrow { margin-bottom: 2.5rem; }
  .ms-lede { color: var(--navy-600); font-weight: 300; font-size: clamp(1.05rem, 1.4vw, 1.25rem); line-height: 1.7; margin: 0; }
  .ms-lede strong { color: var(--navy); font-weight: 500; }
  /* Spend figure as a strip: number + label on one line */
  .ms-strip {
    display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1.1rem;
    margin: 2.5rem 0 0; padding: 1.25rem 1.75rem;
    background: #fff1f1;
    border-radius: var(--radius);
  }
  .ms-num { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.9rem, 3vw, 2.5rem); letter-spacing: -.03em; line-height: 1; color: var(--red-600); }
  .ms-txt { font-size: 1.05rem; color: var(--navy-600); }
</style>
