---
/**
 * Site-wide motion: GSAP ScrollTrigger reveals on native browser scrolling.
 * (Lenis smooth-scroll was removed: taking over the mouse wheel is the most common cause of
 *  "page locks after one scroll" reports, and native scrolling runs off the main thread.)
 * Included once in BaseLayout. Renders no markup — only the script below.
 *
 * Reveal targets reuse the existing `data-aos` attributes in the components:
 *   data-aos="fade-up | fade-left | fade-right | fade | zoom-in | zoom-in-up"
 *   data-aos-delay="120"   (milliseconds, used to stagger cards)
 * Respects prefers-reduced-motion (no reveals).
 */
---

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const FROM: Record<string, gsap.TweenVars> = {
    'fade-up': { y: 40 },
    'fade-down': { y: -40 },
    'fade-left': { x: 50 },
    'fade-right': { x: -50 },
    fade: {},
    'zoom-in': { scale: 0.92 },
    'zoom-in-up': { scale: 0.94, y: 40 },
  };

  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce) {
    root.classList.remove('gsap-ready');
  } else {
    // ---- Scroll reveals for content and cards ----
    gsap.utils.toArray<HTMLElement>('[data-aos]').forEach((el) => {
      const type = el.dataset.aos ?? 'fade-up';
      const delay = (parseInt(el.dataset.aosDelay ?? '0', 10) || 0) / 1000;
      gsap.set(el, { autoAlpha: 0, ...(FROM[type] ?? FROM['fade-up']) });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () =>
          gsap.to(el, {
            autoAlpha: 1, x: 0, y: 0, scale: 1,
            duration: 0.95, delay, ease: 'power3.out',
            clearProps: 'transform', // hand transforms back to CSS hover effects
          }),
      });
    });

    root.classList.add('motion-on');
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
