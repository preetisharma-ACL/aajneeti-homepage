---
/**
 * Site-wide motion: Lenis smooth scrolling + GSAP ScrollTrigger reveals.
 * Included once in BaseLayout. Renders no markup — only the script below.
 *
 * Reveal targets reuse the existing `data-aos` attributes in the components:
 *   data-aos="fade-up | fade-left | fade-right | fade | zoom-in | zoom-in-up"
 *   data-aos-delay="120"   (milliseconds, used to stagger cards)
 * Respects prefers-reduced-motion (no smooth scroll, no reveals).
 */
---

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';

  gsap.registerPlugin(ScrollTrigger);

  const FROM: Record<string, gsap.TweenVars> = {
    'fade-up': { y: 40 },
    'fade-down': { y: -40 },
    'fade-left': { x: 50 },
    'fade-right': { x: -50 },
    fade: {},
    'zoom-in': { scale: 0.92 },
    'zoom-in-up': { scale: 0.94, y: 40 },
  };

  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduce) {
    root.classList.remove('gsap-ready');
  } else {
    // ---- Lenis smooth scroll, driven by GSAP's ticker so ScrollTrigger stays in sync ----
    const lenis = new Lenis({
      duration: 1.15,
      easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      anchors: { offset: -80 },
    });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // Pause smooth scroll while Bootstrap menus / modals are open
    ['show.bs.offcanvas', 'show.bs.modal'].forEach((ev) => document.addEventListener(ev, () => lenis.stop()));
    ['hidden.bs.offcanvas', 'hidden.bs.modal'].forEach((ev) => document.addEventListener(ev, () => lenis.start()));

    // ---- Scroll reveals for content and cards ----
    gsap.utils.toArray<HTMLElement>('[data-aos]').forEach((el) => {
      const type = el.dataset.aos ?? 'fade-up';
      const delay = (parseInt(el.dataset.aosDelay ?? '0', 10) || 0) / 1000;
      gsap.set(el, { autoAlpha: 0, ...(FROM[type] ?? FROM['fade-up']) });
      ScrollTrigger.create({
        trigger: el,
        start: 'top 90%',
        once: true,
        onEnter: () =>
          gsap.to(el, {
            autoAlpha: 1, x: 0, y: 0, scale: 1,
            duration: 0.95, delay, ease: 'power3.out',
            clearProps: 'transform', // hand transforms back to CSS hover effects
          }),
      });
    });

    root.classList.add('motion-on');
    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
