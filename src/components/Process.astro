---
import { steps, links } from '../data/site.js';
---

<section class="section bg-white" aria-labelledby="proc-title">
  <div class="container-hoe">
    <div class="row g-5">
      <div class="col-lg-5">
        <div class="sticky-lg">
          <p class="eyebrow" data-aos="fade-up">How we work</p>
          <h2 id="proc-title" class="title-lg" data-aos="fade-up" data-aos-delay="80">
            From first call to live campaign in <span class="highlight">about a week.</span>
          </h2>
          <p class="lede text-slate-600" data-aos="fade-up" data-aos-delay="160">
            Every client goes through the same four steps, each with a date. Nothing is signed until you've seen it in writing.
          </p>
          <a href={links.contact} class="btn-pill btn-grad lg mt-3" data-aos="fade-up" data-aos-delay="220">Book a free project review <i class="bi bi-arrow-right"></i></a>
        </div>
      </div>

      <div class="col-lg-6 offset-lg-1">
        <ol class="timeline list-unstyled m-0">
          {steps.map((s, i) => (
            <li class="step" data-aos="fade-up" data-aos-delay={String(i * 100)}>
              <span class="step-dot">0{i + 1}</span>
              <div class="step-card">
                <span class="step-when"><i class="bi bi-calendar-event me-1"></i>{s.when}</span>
                <h3 class="fs-4 mt-2 mb-2">{s.title}</h3>
                <p class="text-slate-600 mb-0 lh-lg">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 992px) { .sticky-lg { position: sticky; top: 7rem; } }
  .timeline { position: relative; }
  .timeline::before { content: ''; position: absolute; left: 1.4rem; top: 1rem; bottom: 1rem; width: 2px; background: linear-gradient(var(--red), var(--fuchsia) 60%, var(--slate-200)); }
  .step { position: relative; display: flex; gap: 1.5rem; padding-bottom: 1.5rem; }
  .step:last-child { padding-bottom: 0; }
  .step-dot {
    position: relative; z-index: 1; flex-shrink: 0;
    width: 2.8rem; height: 2.8rem; border-radius: 50%;
    display: grid; place-items: center;
    font-family: var(--font-display); font-weight: 600; font-size: .85rem;
    background: #fff; color: var(--red-600); border: 2px solid var(--red);
    box-shadow: 0 0 0 6px #fff;
    transition: all .3s var(--ease);
  }
  .step:hover .step-dot { background: var(--grad-cta); color: #fff; border-color: transparent; }
  .step-card { flex: 1; border: 1px solid var(--slate-200); border-radius: var(--radius); padding: 1.5rem 1.75rem; background: #fff; transition: all .35s var(--ease); }
  .step:hover .step-card { border-color: var(--red-200); box-shadow: 0 20px 40px -20px rgb(15 23 42 / .2); transform: translateX(4px); }
  .step-when { font-size: .75rem; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--red-600); }
</style>
