---
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.min.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AAJneeti Connect Ltd. | Real Estate Lead Generation Agency in Noida since 2014',
  description = 'We only take projects we can deliver. Up to 60% qualified leads written into your contract, a free CRM and a live dashboard. Lead generation for real estate, education, interiors, travel and B2B.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" href="/images/logo.webp" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/team.webp" />

    <!-- Same type system as houseofeducation.com -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@700&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Poppins:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <!-- Hide reveal targets before first paint (only when JS runs and motion is allowed) -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('gsap-ready');
    </script>
  </head>
  <body>
    <a href="#content" class="visually-hidden-focusable position-fixed top-0 start-0 m-2 p-2 bg-dark text-white rounded z-3">Skip to content</a>
    <slot />

    <script>
      import 'bootstrap/dist/js/bootstrap.bundle.min.js';
      import { initMotion } from '../scripts/motion';

      initMotion();

      // Header: transparent over the dark hero, solid white once scrolled (HOE behaviour)
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const onScroll = () => header?.setAttribute('data-scrolled', String(window.scrollY > 40));
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    </script>
  </body>
</html>
