---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Mission from '../components/Mission.astro';
import Partners from '../components/Partners.astro';
import Guarantee from '../components/Guarantee.astro';
import Industries from '../components/Industries.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Platform from '../components/Platform.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import Founder from '../components/Founder.astro';
import VideoFeature from '../components/VideoFeature.astro';
import Offices from '../components/Offices.astro';
import Insights from '../components/Insights.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { developers, channelPartners } from '../data/site.js';
---

<BaseLayout>
  <Header />
  <main id="content">
    <Hero />
    <Partners
      id="developers"
      eyebrow="Our developers &amp; channel partners clients"
      title="Trusted by 200+ developers, channel partners and brands"
      titleHl="since 2014."
      sub="Campaigns for some of India's most trusted real estate developers, from launches to sustained sales."
      logos={developers}
      direction="left"
      variant="plain"
      second={{
        label: 'Channel partners',
        desc: 'Brokers and channel partners we generate qualified leads for.',
        logos: channelPartners,
        direction: 'right',
      }}
    />
    <Mission />
    <Guarantee />
    <Industries />
    <CaseStudies />
    <Platform />
    <Process />
    <Testimonials />
    <Founder />
    <VideoFeature />
    <Offices />
    <About />
    <Insights />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
</BaseLayout>
